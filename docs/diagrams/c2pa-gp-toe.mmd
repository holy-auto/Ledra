%% Ledra Generator Product — Target of Evaluation (TOE), Backend class, Assurance Level 1
%% TOE boundary: from asset capture/upload through claim signing to persistence of the signed asset.
flowchart TB
    subgraph CLIENT["Outside TOE — untrusted clients (upload only)"]
        WEB["Web admin app<br/>(browser upload)"]
        MOB["Mobile app<br/>(upload)"]
    end

    subgraph TOE["GP TOE boundary — Backend (Vercel serverless + Supabase)"]
        direction TB
        AUTH["Caller authentication<br/>Web: resolveCallerWithRole (Supabase auth + role)<br/>Mobile: resolveMobileCaller + role + capture-nonce<br/>(device attestation code present, disabled in this configuration)"]
        PIPE["Authenticity pipeline<br/>SHA-256 hash (pre-sign) · EXIF/GPS strip &amp; re-encode (sharp)<br/>capture-nonce consume · stage tag<br/>(input sharp cannot decode, e.g. HEVC HEIC: signed as received)"]
        ASSERT["Assertion generation<br/>parentOf ingredient = uploaded file<br/>(C2PA of the upload validated here)<br/>c2pa.actions.v2 (created assertion): opened<br/>+ orientation / converted / edited.metadata<br/>only when applied<br/>com.ledra.capture (cert id, VIN, nonce)"]
        SIGN["Claim signing<br/>@contentauth/c2pa-node LocalSigner<br/>ES256 / P-256"]
        KEY["Signing credential<br/>C2PA_SIGNER_CERT / _KEY<br/>(env, encrypted at rest; resident in signer process memory)"]
        STORE["Signed asset + manifest summary<br/>persisted to Supabase Storage / Postgres<br/>(service-role client; tenant isolation at app layer, RLS bypassed)"]
    end

    subgraph EXT["External services"]
        CA["Conformant CA<br/>(Claim Signing Certificate,<br/>manually provisioned)"]
        CHAIN["Polygon anchoring<br/>(configuration-gated, hash only)"]
        HIVE["Hive AI-image detection<br/>(configuration-gated, pre-sign image)"]
        IPFS["Pinata IPFS pinning<br/>(configuration-gated, signed asset)"]
    end

    WEB --> AUTH
    MOB --> AUTH
    AUTH --> PIPE --> ASSERT --> SIGN --> STORE
    KEY --> SIGN
    CA -. issues cert .-> KEY
    %% Polygon anchors the PRE-SIGN pipeline hash (SHA-256 of the stripped buffer),
    %% not the stored signed bytes — embedding the manifest changes the bytes.
    PIPE -. pre-sign hash .-> CHAIN
    PIPE -. pre-sign image .-> HIVE
    SIGN -. signed asset .-> IPFS

    classDef toe fill:#e8f0fe,stroke:#1a73e8,stroke-width:1px;
    classDef ext fill:#f1f3f4,stroke:#5f6368,stroke-width:1px;
    classDef cli fill:#fef7e0,stroke:#f9ab00,stroke-width:1px;
    class AUTH,PIPE,ASSERT,SIGN,KEY,STORE toe;
    class CA,CHAIN,HIVE,IPFS ext;
    class WEB,MOB cli;
