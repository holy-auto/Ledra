{
  "expo": {
    "name": "Ledra",
    "slug": "admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ledra",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#d6d0cb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ledra.app",
      "infoPlist": {
        "NFCReaderUsageDescription": "Ledraは証明書NFCタグの読み取りと書き込みに使用します",
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiredDeviceCapabilities": ["arm64", "iphone-ipad-minimum-performance-a12"]
      },
      "entitlements": {
        "com.apple.developer.proximity-reader.payment.acceptance": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.ledra.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "82934b68-084f-45f0-8a4e-0abba3d124cd"
      },
      "router": {}
    },
    "owner": "cartrust",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Ledraのロック解除に Face ID を使用します"
        }
      ],
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Ledraは施工写真の撮影と、顧客へ送る画像の撮影に使用します",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ledraは施工写真の選択と、顧客へ送る画像の選択に使用します",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Ledraは施工写真を端末に保存するために使用します",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": false,
          "locationWhenInUsePermission": "Stripe Terminal の利用に位置情報が必要です",
          "bluetoothPeripheralPermission": "将来のカードリーダー接続にBluetoothを使用します",
          "bluetoothAlwaysUsagePermission": "将来のカードリーダー接続にBluetoothを使用します",
          "localNetworkUsagePermission": "Stripe Terminal のリーダー検出に使用します",
          "tapToPayCheck": true,
          "appDelegate": true
        }
      ],
      [
        "./plugins/withNfcLocal",
        {
          "nfcPermission": "Ledraは証明書NFCタグの読み取りと書き込みに使用します"
        }
      ],
      "./plugins/withRemoveTapToPayEntitlement"
    ]
  }
}
