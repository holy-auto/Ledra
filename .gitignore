# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp

# scratch / temporary files (e.g. generated PDFs for review)
/tmp/

# UI reference images (visual targets, not committed to repo)
/references/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# claude code worktrees (prevents Tailwind/Turbopack from scanning symlinks)
.claude/

# Screenshots captured by CI (directories tracked via .gitkeep)
public/screenshots/**/*.png

# ただし配布 PDF が差し込む3枚だけはコミットする。撮影しているのは Remotion の
# 動画ワークフローだけで、成果物は artifact に上がるだけ ―― Vercel のビルドは
# 撮影しない。リポジトリに無い＝本番の PDF ではスライドが永久に出ない
# （ScreenshotSlide はファイルが無ければ黙ってページごと消えるので気づけない）。
# 参照先とこの一覧のズレは resourcePdf.render.test.tsx が検出する。
!public/screenshots/admin/certs-new.png
!public/screenshots/admin/customers-detail.png
!public/screenshots/insurer/search.png

# Remotion rendered output
/out/

# typescript
*.tsbuildinfo

# Local backup files created by patch scripts
*.bak_*

_backup/
_diag/

# backups
*.bak.*

# temp clip patch
scripts/_clip_patch.ps1
scripts/_clip_patch*.ps1

# PowerShell one-off patch scripts (historical, no longer executed)
/fix-insurer-build.ps1

# Dev server log (must never be committed)
/dev-server.log

# Scratch notes (Japanese-named temp files)
/上で出たパス.txt

.vercel

# HP growth-ops analytics exports (never commit — may contain PII). README is tracked.
/docs/marketing/data/*
!/docs/marketing/data/README.md
