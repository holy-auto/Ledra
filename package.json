{
  "name": "holy-cert",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:migrations": "node scripts/lint-migrations.js",
    "check:migrations": "node scripts/replay-migrations.mjs",
    "audit:retry": "tsx scripts/audit-withRetry.ts",
    "audit:retry:strict": "tsx scripts/audit-withRetry.ts --strict",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "prepare": "husky",
    "demo:setup": "tsx scripts/setup-demo-agent.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "demo:setup-insurer": "tsx scripts/setup-demo-insurer.ts",
    "demo:setup-manufacturer": "tsx scripts/setup-demo-manufacturer.ts",
    "demo:setup-tenant": "tsx scripts/setup-demo-tenant.ts",
    "demo:setup-tenant-user": "tsx scripts/setup-demo-tenant-user.ts",
    "demo:reset-tenant": "tsx scripts/setup-demo-tenant.ts --reset",
    "video:studio": "remotion studio remotion/index.tsx",
    "video:render": "remotion render remotion/index.tsx LedraIntro out/LedraIntro.mp4",
    "video:render:tour": "remotion render remotion/index.tsx ProductTour out/ProductTour.mp4",
    "screenshots:capture": "tsx scripts/capture-screenshots.ts",
    "check:secrets-age": "tsx scripts/check-secrets-age.ts",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "check:schema": "node scripts/check-schema.mjs",
    "check:context-dates": "node scripts/check-context-dates.mjs",
    "check:resurrected": "bash scripts/check-resurrected-files.sh",
    "build:analyze": "ANALYZE=true next build",
    "db:typegen": "supabase gen types typescript --db-url \"${SUPABASE_DB_URL:?db-migrate.yml と同じ接続URIを設定してください}\" --schema public > src/types/db.generated.ts.tmp && mv src/types/db.generated.ts.tmp src/types/db.generated.ts"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "ox": "0.14.29",
    "esbuild": "0.28.1",
    "ws": "^8.21.0",
    "undici": "^7.28.0",
    "postcss": "^8.5.18",
    "uuid": "^11.1.1",
    "sharp": "^0.35.3",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --no-warn-ignored"
    ],
    "src/**/*.{json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@aws-sdk/client-kms": "^3.1125.0",
    "@googleapis/calendar": "^14.2.0",
    "@gsap/react": "^2.1.2",
    "@noble/curves": "^1.9.7",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@peculiar/webcrypto": "^1.7.1",
    "@peculiar/x509": "^2.0.0",
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/fiber": "^9.7.0",
    "@remotion/cli": "^4.0.520",
    "@sentry/nextjs": "^10.73.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.22.0",
    "cbor-x": "^1.6.6",
    "cheerio": "^1.2.0",
    "driver.js": "^1.8.0",
    "ethers": "^6.17.0",
    "exifr": "^7.1.3",
    "google-auth-library": "^10.9.1",
    "gsap": "^3.15.0",
    "import-in-the-middle": "^3.4.0",
    "jszip": "^3.10.1",
    "konva": "^9.3.16",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "posthog-js": "^1.425.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "18.2.10",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "remotion": "^4.0.454",
    "require-in-the-middle": "^8.0.1",
    "resend": "^6.25.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3",
    "stripe": "^20.4.1",
    "svix": "^1.99.1",
    "swr": "^2.5.1",
    "three": "^0.185.1",
    "viem": "^2.56.3",
    "zod": "^4.5.4"
  },
  "optionalDependencies": {
    "@contentauth/c2pa-node": "^0.9.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5"
  }
}
