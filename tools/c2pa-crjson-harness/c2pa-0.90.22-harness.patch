diff -ruN a/src/harness_overrides.rs b/src/harness_overrides.rs
--- a/src/harness_overrides.rs	1970-01-01 00:00:00.000000000 +0000
+++ b/src/harness_overrides.rs	2026-09-29 14:56:02.288126347 +0000
@@ -0,0 +1,13 @@
+//! Ledra crJSON test harness only (C2PA Conformance Program v0.2 §2.3). Not part of upstream c2pa-rs.
+//!
+//! Upstream 0.90.22 has one trust store for claim signers and time-stamp authorities and always
+//! validates at the current system time. The harness sets these once, before reading an asset.
+use std::sync::OnceLock;
+
+use crate::crypto::cose::CertificateTrustPolicy;
+
+/// Validation time used instead of the system clock (certificate validity, OCSP, reported validationTime).
+pub static VALIDATION_TIME: OnceLock<chrono::DateTime<chrono::Utc>> = OnceLock::new();
+
+/// Trust policy for time-stamp authority certificates, used instead of the claim-signer trust list.
+pub static TSA_TRUST_POLICY: OnceLock<CertificateTrustPolicy> = OnceLock::new();
